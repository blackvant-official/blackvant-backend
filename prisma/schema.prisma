// ------------------------------------------------------
// BLACKVANT — Production-Ready Prisma Schema (v1.0)
// ------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ------------------------------------------------------
// USER TABLE
// ------------------------------------------------------
model User {
  id                String   @id @default(cuid())
  clerkId           String   @unique
  email             String   @unique
  fullName          String?
  role              String   @default("client") // client | admin | superadmin
  ledgerEntries     Ledger[]

  referralCode      String?  @unique
  referredById      String?
  referredBy        User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals         User[]   @relation("UserReferrals")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deposits          Deposit[]
  withdrawals       Withdrawal[]
  profitPayouts     ProfitPayout[]
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]

  // Opposite relations for admin actions
  depositsReviewed     Deposit[]            @relation("DepositReviewedBy")
  withdrawalsReviewed  Withdrawal[]         @relation("WithdrawalReviewedBy")
  profitDistributionsCreated ProfitDistribution[] @relation("ProfitCreatedBy")
}



// ------------------------------------------------------
// DEPOSIT TABLE
// ------------------------------------------------------
model Deposit {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  amount         Decimal  @db.Decimal(18, 4)
  currency       String
  method         String

  txId           String?
  proofKey       String?

  status         String   @default("pending") // pending | approved | rejected
  statusReason   String?

  reviewedById   String?
  reviewedBy     User?    @relation("DepositReviewedBy", fields: [reviewedById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  approvedAt     DateTime?
}

// ------------------------------------------------------
// WITHDRAWAL TABLE
// ------------------------------------------------------
model Withdrawal {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  amount         Decimal  @db.Decimal(18, 4)
  currency       String
  source         String   // profit

  method         String
  targetAddress  String

  status         String   @default("pending")
  statusReason   String?

  reviewedById   String?
  reviewedBy     User?    @relation("WithdrawalReviewedBy", fields: [reviewedById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  approvedAt     DateTime?
}

// ------------------------------------------------------
// PROFIT DISTRIBUTION 
// ------------------------------------------------------
model ProfitDistribution {
  id                  String   @id @default(cuid())

  distributionPercent Decimal  @db.Decimal(6, 4)
  distributionDate    DateTime
  note                String?

  totalDistributed    Decimal  @db.Decimal(18, 4)
  recipientsCount     Int

  status              ProfitDistributionStatus @default(PENDING)

  createdById         String
  createdBy           User     @relation("ProfitCreatedBy", fields: [createdById], references: [id])

  payouts             ProfitPayout[]

  createdAt           DateTime @default(now())
}


// ------------------------------------------------------
// PROFIT PAYOUT (Each User in Distribution)
// ------------------------------------------------------
model ProfitPayout {
  id                       String   @id @default(cuid())

  distributionId           String
  distribution             ProfitDistribution @relation(fields: [distributionId], references: [id])

  userId                   String
  user                     User     @relation(fields: [userId], references: [id])

  activeInvestmentSnapshot Decimal  @db.Decimal(18, 4)
  profitAmount             Decimal  @db.Decimal(18, 4)

  ledgerEntryId            String?   // references Ledger.id (no Prisma relation)


  createdAt                DateTime @default(now())

  @@unique([distributionId, userId])
}


// ------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])

  action      String
  entityType  String
  entityId    String
  meta        Json?

  ip          String?
  userAgent   String?

  createdAt   DateTime @default(now())
}

// ------------------------------------------------------
// SUPPORT TICKET
// ------------------------------------------------------
model SupportTicket {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  subject     String
  description String
  priority    String   // low | medium | high
  status      String   @default("open") // open | in_progress | resolved | closed

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    SupportMessage[]
}

// ------------------------------------------------------
// SUPPORT MESSAGE (THREAD)
// ------------------------------------------------------
model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])

  sender    String   // user | admin
  message   String

  createdAt DateTime @default(now())
}

model FileAttachment {
  id           String   @id @default(cuid())
  ownerUserId  String
  purpose      AttachmentPurpose
  mimeType     String
  fileSize     Int
  storageKey   String
  originalName String

  depositId    String?
  ticketId     String?

  createdAt    DateTime @default(now())

  @@index([ownerUserId])
  @@index([depositId])
  @@index([ticketId])
}

enum AttachmentPurpose {
  DEPOSIT_PROOF
  SUPPORT_MESSAGE
}

// ------------------------------------------------------
// LEDGER (Single Source of Financial Truth)
// ------------------------------------------------------
model Ledger {
  id            String   @id @default(cuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id])

  amount        Decimal  @db.Decimal(18, 4)
  direction     String   // credit | debit

  referenceType String   // DEPOSIT | WITHDRAWAL | PROFIT
  referenceId   String   // depositId / withdrawalId / payoutId

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([referenceType, referenceId])
}

enum ProfitDistributionStatus {
  PENDING
  VERIFIED
  DISTRIBUTED
}

// ------------------------------------------------------
// Admin OTP model
// ------------------------------------------------------
model AdminProfitOtp {
  id                String   @id @default(cuid())

  profitDistributionId String   // references ProfitDistribution.id (no Prisma relation)
  adminUserId          String   // references User.id (no Prisma relation)


  otpHash           String
  expiresAt         DateTime
  usedAt            DateTime?

  createdAt         DateTime @default(now())

  @@index([profitDistributionId])
  @@index([adminUserId])
}
